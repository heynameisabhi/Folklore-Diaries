generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contributor {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String?
  age               Int?
  address           String?
  guru_name         String?
  practice_duration String?
  drug_contributor  drug_contributor[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model disease {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @unique
  drug_disease drug_disease[]
  usage_method usage_method[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drug {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  primary_name          String?
  botanical_description String?
  source_type           source_type?
  created_at            DateTime?          @default(now()) @db.Timestamp(6)
  drug_contributor      drug_contributor[]
  drug_disease          drug_disease[]
  drug_names            drug_names[]
  drug_photos           drug_photos[]
  research              research[]
  usage_method          usage_method[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drug_contributor {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drug_id        String?      @db.Uuid
  contributor_id String?      @db.Uuid
  contributor    contributor? @relation(fields: [contributor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drug           drug?        @relation(fields: [drug_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drug_disease {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drug_id    String?  @db.Uuid
  disease_id String?  @db.Uuid
  disease    disease? @relation(fields: [disease_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drug       drug?    @relation(fields: [drug_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drug_names {
  id      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String?
  type    drug_name_type?
  drug_id String?         @db.Uuid
  drug    drug?           @relation(fields: [drug_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drug_photos {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image_url String?
  drug_id   String? @db.Uuid
  drug      drug?   @relation(fields: [drug_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model research {
  id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type    research_type?
  title   String?
  link    String?
  drug_id String?        @db.Uuid
  drug    drug?          @relation(fields: [drug_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usage_method {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drug_id            String?  @db.Uuid
  disease_id         String?  @db.Uuid
  method_description String?
  disease            disease? @relation(fields: [disease_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drug               drug?    @relation(fields: [drug_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String?
  email  String       @unique
  role   user_role?   @default(USER)
  status user_status? @default(ACTIVE)
}

enum drug_name_type {
  BOTANICAL
  SANSKRIT
  VERNACULAR
}

enum research_type {
  ARTICLE
  THESIS
}

enum source_type {
  PLANT
  ANIMAL
  MINERAL
}

enum user_role {
  ADMIN
  USER
}

enum user_status {
  ACTIVE
  BLOCKED
}
